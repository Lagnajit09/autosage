# ── Auth (T10) ───────────────────────────────────────────────────────────
# Same Clerk app as Django — autobot verifies the same JWTs against the
# same JWKS. CLERK_SECRET_KEY is only used to authenticate the JWKS fetch
# (just like server/server/middleware.py::ClerkAuthMiddleware does).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Internal endpoints (T11) ─────────────────────────────────────────────
# Where autobot reaches Django for thread persistence + tool calls.
# Compose DNS resolves the service name. In prod compose, the django
# service is named `django`; in dev compose, it's named `server`.
# Adjust to match the file you're running.
DJANGO_INTERNAL_URL=http://server:8000

# Redis DB index reserved for autobot's hot conversation cache. Celery is
# on /0 (broker + result), /1 is unused, /2 is autobot — see plan T00 +
# the docker-compose.oci.yml redis comment for the volatile-lru rationale.
REDIS_URL=redis://redis:6379/2

# ── LLM providers (T12 — admin defaults; users may BYO via Vault) ────────
# Get keys from each provider's console. Empty values disable that provider
# from the default fallback chain. At least one must be set for the
# admin/default path to work.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Default provider/model when the user has no BYO key configured.
# Choose a free-tier-friendly default (Gemini Flash and Groq Llama are both
# fine choices; gemini-1.5-flash has the biggest free context window).
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini/gemini-1.5-flash

# ── Behavior tuning (T14, T16, T18) ──────────────────────────────────────
# Hard cap on tool-call rounds per user turn — guards against the model
# looping forever. On hitting it, the loop forces a tool-free final answer
# (no dead-end error). Execution turns are tool-heavy, so 10 leaves headroom.
AUTOBOT_MAX_TOOL_ROUNDS=10

# Redis TTL for hot conversation context (seconds). Refreshed on access.
# 7200s = 2h matches the "inactive thread" spec.
AUTOBOT_CTX_TTL_SECONDS=7200

# Summarization trigger as a ratio of the model's context window.
AUTOBOT_CONTEXT_TARGET_RATIO=0.6

# Number of recent messages kept verbatim across a summarization pass.
AUTOBOT_KEEP_LAST_N=8

# Standard Python log level. Use INFO in dev/prod; DEBUG only locally with
# the log redaction filter (T10) intact — it strips Authorization headers
# before they reach the formatter.
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated origins permitted to call autobot from the browser.
# Same purpose as Django's CORS_ALLOWED_ORIGINS — without it the browser
# blocks /api/ai/* requests from cross-origin SPAs (Vite dev :5173,
# different host in prod, etc.).
#
# Dev:  http://localhost:5173,http://localhost:8080
#       (Vite + nginx host port cover both "hit nginx" and "hit dev server")
# Prod: the public frontend origin(s) — Firebase Hosting site and any
#       same-host SPA served from the DuckDNS hostname.
#       Example: https://autosage-web.web.app,https://<your>.duckdns.org
# IMPORTANT (prod): no trailing slashes, scheme matters (https in prod).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
