# ── Auth (T10) ───────────────────────────────────────────────────────────
# Same Clerk app as Django — autobot verifies the same JWTs against the
# same JWKS. CLERK_SECRET_KEY is only used to authenticate the JWKS fetch
# (just like server/server/middleware.py::ClerkAuthMiddleware does).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Internal endpoints (T11) ─────────────────────────────────────────────
# Where autobot reaches Django for thread persistence + tool calls.
# Compose DNS resolves the service name. In prod compose, the django
# service is named `django`; in dev compose, it's named `server`.
# Adjust to match the file you're running.
DJANGO_INTERNAL_URL=http://server:8000

# Shared secret for the public docs-RAG path (Pillar A). Autobot presents it
# as `X-Internal-Secret` on its no-JWT call to Django's
# /api/autobot/docs/search/ endpoint; Django constant-time-compares it. MUST
# match AUTOBOT_INTERNAL_SECRET in server/.env exactly. Empty here → the docs
# tool fails closed (Django rejects an empty/absent secret), so a misconfigured
# deploy can never accidentally expose the endpoint. Generate a long random
# value, e.g. `openssl rand -hex 32`.
AUTOBOT_INTERNAL_SECRET=

# Redis DB index reserved for autobot's hot conversation cache. Celery is
# on /0 (broker + result), /1 is unused, /2 is autobot — see plan T00 +
# the docker-compose.oci.yml redis comment for the volatile-lru rationale.
REDIS_URL=redis://redis:6379/2

# ── LLM providers (T12 — admin defaults; users may BYO via Vault) ────────
# Get keys from each provider's console. Empty values disable that provider
# from the default fallback chain. At least one must be set for the
# admin/default path to work.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Default provider/model when the user has no BYO key configured.
# Choose a free-tier-friendly default (Gemini Flash and Groq Llama are both
# fine choices; gemini-1.5-flash has the biggest free context window).
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini/gemini-1.5-flash

# ── Behavior tuning (T14, T16, T18) ──────────────────────────────────────
# Hard cap on tool-call rounds per user turn — guards against the model
# looping forever. On hitting it, the loop forces a tool-free final answer
# (no dead-end error). Execution turns are tool-heavy, so 10 leaves headroom.
AUTOBOT_MAX_TOOL_ROUNDS=10

# Redis TTL for hot conversation context (seconds). Refreshed on access.
# 7200s = 2h matches the "inactive thread" spec.
AUTOBOT_CTX_TTL_SECONDS=7200

# Summarization trigger as a ratio of the model's context window.
AUTOBOT_CONTEXT_TARGET_RATIO=0.6

# Number of recent messages kept verbatim across a summarization pass.
AUTOBOT_KEEP_LAST_N=8

# Number of executions through Autobot allowed per day
AUTOBOT_EXEC_DAILY_LIMIT=10

# ── Public docs assistant (Pillar A) ─────────────────────────────────────
# Tunables for the no-Clerk Docusaurus docs widget (POST /api/ai/docs/chat/
# stream/). All bound the PUBLIC, unauthenticated path. The internal secret
# above gates the Django docs-search call; these gate the public endpoint.
#
# Per-IP daily cap on docs-chat turns (Redis /2, fail-open). Keyed by client
# IP — NOT session_id — because session_id is client-generated and trivially
# rotatable, so it can't bound abuse. 0 disables. See the router docstring.
AUTOBOT_DOCS_DAILY_LIMIT=50
# Burst rate limit (slowapi), IP-keyed automatically (no Bearer on this path).
AUTOBOT_DOCS_RATE_LIMIT=10/minute
# TTL (seconds) for an anonymous docs chat session in Redis. ~2h keeps a
# visitor's thread warm across page navigation; nothing persists in Django.
AUTOBOT_DOCS_SESSION_TTL=7200
# Max chars accepted in a single docs-chat message (clamped server-side).
AUTOBOT_DOCS_MAX_MESSAGE_CHARS=2000
# Prior turns of anon history replayed into model context (bounds prompt cost).
AUTOBOT_DOCS_MAX_HISTORY_TURNS=12
# Tool-call rounds cap for the docs loop (search_docs is the only tool).
AUTOBOT_DOCS_MAX_TOOL_ROUNDS=3

# Standard Python log level. Use INFO in dev/prod; DEBUG only locally with
# the log redaction filter (T10) intact — it strips Authorization headers
# before they reach the formatter.
LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated origins permitted to call autobot from the browser.
# Same purpose as Django's CORS_ALLOWED_ORIGINS — without it the browser
# blocks /api/ai/* requests from cross-origin SPAs (Vite dev :5173,
# different host in prod, etc.).
#
# Dev:  http://localhost:5173,http://localhost:8080,http://localhost:3000
#       (Vite + nginx host port; :3000 is the Docusaurus docs dev server,
#        whose AutobotWidget calls /api/ai/docs/chat/stream/ directly)
# Prod: the public frontend origin(s) — Firebase Hosting site, any same-host
#       SPA on the DuckDNS hostname, AND the deployed docs site origin (the
#       docs widget hits autobot cross-origin from the browser — without its
#       origin here the streaming fetch is blocked; Pillar A / plan 4.1).
#       Example: https://autosage-web.web.app,https://<your>.duckdns.org,https://<your-docs-site>
# IMPORTANT (prod): no trailing slashes, scheme matters (https in prod).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000
